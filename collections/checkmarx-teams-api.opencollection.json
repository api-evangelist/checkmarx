{
  "opencollection": "1.0.0",
  "info": {
    "name": "Checkmarx One Applications Teams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Checkmarx List all teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ast.checkmarx.net/api/auth/teams"
          },
          "docs": "Retrieve a list of all teams in the system."
        }
      ]
    }
  ],
  "bundled": true
}