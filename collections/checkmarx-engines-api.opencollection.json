{
  "opencollection": "1.0.0",
  "info": {
    "name": "Checkmarx One Applications Engines API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Engines",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Checkmarx List engine servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ast.checkmarx.net/api/sast/engineServers"
          },
          "docs": "Retrieve a list of all configured SAST engine servers."
        }
      ]
    }
  ],
  "bundled": true
}